pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {BridgeVaultFailsafe as V} from "../../src/failsafe/BridgeVaultFailsafe.sol";
import {MockVerifier, TestToken} from "../mocks/Mocks.sol";
import {ReclaimVector as RV} from "../fixtures/ReclaimVector.sol";

/// Replays the G4 vectors generated by lez-bridge/reclaim/host (journals produced by the reclaim
/// guest in RISC Zero's executor): three seed-derived deposits, deposit 1 claimed on LEZ, the final
/// G2 state over that accumulator. Each reclaim is submitted with a seal built from the FIXTURE's
/// journal digest; the MockVerifier accepts it only if the vault's own digest is the same, so a
/// successful `reclaim` shows the vault hashes exactly the guest's 288-byte journal. The claimed
/// deposit has no vector: the guest refuses it (reclaim/host/tests/reclaim.rs).
contract ReclaimVectorTest is Test {
    bytes32 constant G2 = keccak256("g2-image");
    bytes32 constant G3 = keccak256("g3-image");
    bytes32 constant STATE0 = keccak256("state0");
    /// Any id: the MockVerifier binds the seal to it, and the journals do not depend on it.
    bytes32 constant G4 = keccak256("g4-image");

    V v;
    MockVerifier mv;

    function setUp() public {
        vm.chainId(RV.CHAIN_ID);
        mv = new MockVerifier();
        bytes memory args = abi.encode(
            address(mv), G2, G3, G4, RV.LEZ_CHAIN_ID, RV.ZONE_ID, RV.PROGRAM_ID, STATE0, uint64(0),
            address(this), address(this), address(this)
        );
        deployCodeTo("BridgeVaultFailsafe.sol:BridgeVaultFailsafe", args, RV.VAULT);
        v = V(RV.VAULT);
        assertEq(v.cfgId(), RV.CFG_ID, "cfgId");
        vm.etch(RV.USDC, address(new TestToken("T", 6)).code);
        uint256[] memory d = new uint256[](1);
        d[0] = RV.DENOM;
        uint256[] memory z = new uint256[](1);
        v.registerToken(RV.USDC, 6, d, z, z, 0);
        uint256[][] memory menu = new uint256[][](1);
        menu[0] = new uint256[](1);
        menu[0][0] = 1e6;
        v.setRelayFeeMenu(RV.USDC, menu);
        TestToken(RV.USDC).mint(address(this), 1e15);
        TestToken(RV.USDC).approve(address(v), type(uint256).max);
        bytes32[] memory c = RV.commitments();
        for (uint256 i; i < c.length; ++i) v.deposit(RV.USDC, 0, c[i]);
    }

    function _update(bytes32 next, uint64 claims) internal {
        V.ClaimDelta[] memory cl = new V.ClaimDelta[](claims == 0 ? 0 : 1);
        if (claims != 0) cl[0] = V.ClaimDelta(RV.USDC, 0, claims);
        bytes memory j = abi.encode(V.UpdateJournal(v.cfgId(), v.g2State(), next, new bytes32[](0), cl, new V.Exit[](0)));
        v.update(j, mv.sealFor(G2, sha256(j)));
    }

    /// Deposit 1's claim lands; wind-down; the next update reaches the fixture's final state.
    function _toFinal() internal {
        _update(keccak256("after the claim"), 1);
        v.windDown();
        _update(RV.FINAL_STATE, 0);
        assertEq(v.finalState(), RV.FINAL_STATE);
    }

    function test_GuestJournalsReclaimOnTheVault() public {
        RV.ReclaimV[] memory r = RV.reclaims();
        assertEq(v.depositRoot(), r[0].depositRoot, "the guest's deposit root is the vault's");
        _toFinal();
        for (uint256 i; i < r.length; ++i) {
            assertEq(sha256(r[i].journal), r[i].journalDigest);
            bytes memory seal = mv.sealFor(G4, r[i].journalDigest);
            v.reclaim(seal, r[i].depositRoot, r[i].nullifier, RV.USDC, 0, r[i].recipient, r[i].relayer, r[i].relayFee);
            assertEq(TestToken(RV.USDC).balanceOf(r[i].recipient), RV.DENOM - r[i].relayFee);
            if (r[i].relayFee != 0) assertEq(TestToken(RV.USDC).balanceOf(r[i].relayer), r[i].relayFee);
        }
        assertEq(TestToken(RV.USDC).balanceOf(address(v)), RV.DENOM, "only the claimed deposit stays");
        assertEq(v.reclaims(RV.USDC, 0), 2);
    }

    function test_GuestJournalsAreRefusedBeforeTheFinalReplayedOrRedirected() public {
        RV.ReclaimV[] memory r = RV.reclaims();
        bytes memory seal = mv.sealFor(G4, r[1].journalDigest);
        vm.expectRevert(V.NotWoundDown.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, r[1].relayer, r[1].relayFee);
        _update(keccak256("after the claim"), 1);
        v.windDown();
        vm.expectRevert(V.NotFinal.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, r[1].relayer, r[1].relayFee);
        // a final state other than the one the guest proved against: the digest differs
        _update(keccak256("some other final"), 0);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, r[1].relayer, r[1].relayFee);
    }

    function test_ReplayAndRedirectRefused() public {
        RV.ReclaimV[] memory r = RV.reclaims();
        _toFinal();
        bytes memory seal = mv.sealFor(G4, r[1].journalDigest);
        address thief = makeAddr("thief");
        vm.startPrank(r[1].relayer);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, thief, r[1].relayer, r[1].relayFee);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, thief, r[1].relayFee);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, r[1].relayer, r[1].relayFee);
        vm.expectRevert(V.NullifierSpent.selector);
        v.reclaim(seal, r[1].depositRoot, r[1].nullifier, RV.USDC, 0, r[1].recipient, r[1].relayer, r[1].relayFee);
        vm.stopPrank();
        assertEq(TestToken(RV.USDC).balanceOf(thief), 0);
    }
}
