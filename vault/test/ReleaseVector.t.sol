pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {BridgeVault} from "../src/BridgeVault.sol";
import {MockVerifier, TestToken} from "./mocks/Mocks.sol";
import {ReleaseVector as RV} from "./fixtures/ReleaseVector.sol";

/// Replays the G3 vectors generated by lez-bridge/release/host (journals produced by the guest in
/// RISC Zero's executor). The exits go in through `update()` exactly as the fixture batched them,
/// the vault's `exitRoot()` must equal the fixture's root after every batch, and each release is
/// submitted with a seal built from the fixture's `sha256(journal)`: the MockVerifier accepts a
/// seal only if it equals `imageId | digest` for the digest the vault computed, so a successful
/// `release` proves the vault's digest equals the guest's journal digest byte for byte. (The mock
/// can't record the digest: the vault calls `verify` with STATICCALL.)
contract ReleaseVectorTest is Test {
    bytes32 constant G2 = keccak256("g2-image");
    bytes32 constant G3 = keccak256("g3-image");

    BridgeVault v;
    MockVerifier mv;

    function setUp() public {
        vm.chainId(RV.CHAIN_ID);
        mv = new MockVerifier();
        bytes memory args = abi.encode(
            address(mv), G2, G3, RV.LEZ_CHAIN_ID, RV.ZONE_ID, RV.PROGRAM_ID, bytes32(0), uint64(0),
            address(this), address(this), address(this), uint64(1 hours)
        );
        deployCodeTo("BridgeVault.sol:BridgeVault", args, RV.VAULT);
        v = BridgeVault(RV.VAULT);
        assertEq(v.cfgId(), RV.CFG_ID, "cfgId");

        vm.etch(RV.USDC, address(new TestToken("T", 6)).code);
        uint256[] memory z = new uint256[](3);
        v.registerToken(RV.USDC, 6, RV.usdcDenoms(), z, RV.usdcWithdrawFees(), 0);
        v.registerToken(address(0), 18, RV.ethDenoms(), z, RV.ethWithdrawFees(), 0);
        // the fixture's relay fees go on the menu (F#13); the fixture itself is unchanged
        v.setRelayFeeMenu(RV.USDC, _fixtureMenu(RV.USDC));
        v.setRelayFeeMenu(address(0), _fixtureMenu(address(0)));
        TestToken(RV.USDC).mint(address(this), 1e15);
        TestToken(RV.USDC).approve(address(v), type(uint256).max);
        vm.deal(address(this), 1000 ether);
    }

    /// The distinct non-zero relay fees the fixture's releases use for `token`, per denomination.
    function _fixtureMenu(address token) internal pure returns (uint256[][] memory m) {
        RV.ReleaseV[] memory rs = RV.releases();
        m = new uint256[][](3);
        for (uint256 d; d < 3; ++d) {
            uint256[] memory fees = new uint256[](rs.length);
            uint256 n;
            for (uint256 i; i < rs.length; ++i) {
                RV.ReleaseV memory r = rs[i];
                if (r.token != token || r.denomIndex != d || r.relayFee == 0) continue;
                bool seen;
                for (uint256 k; k < n; ++k) seen = seen || fees[k] == r.relayFee;
                if (!seen) fees[n++] = r.relayFee;
            }
            assembly {
                mstore(fees, n)
            }
            m[d] = fees;
        }
    }

    /// One deposit and one claim per exit (same token and denomination), then the exits in the
    /// fixture's batches. Checks every leaf and the root after every batch.
    function _applyExits() internal {
        RV.ExitV[] memory ex = RV.exits();
        uint256[] memory sizes = RV.batchSizes();
        bytes32[] memory roots = RV.batchRoots();

        BridgeVault.ClaimDelta[] memory claims = new BridgeVault.ClaimDelta[](ex.length);
        for (uint256 i; i < ex.length; ++i) {
            bytes32 c = keccak256(abi.encode("dep", i));
            if (ex[i].token == address(0)) v.depositETH{value: ex[i].denom}(ex[i].denomIndex, c);
            else v.deposit(ex[i].token, ex[i].denomIndex, c);
            claims[i] = BridgeVault.ClaimDelta(ex[i].token, ex[i].denomIndex, 1);
            assertEq(v.exitLeaf(ex[i].token, ex[i].denom, ex[i].commitment), ex[i].leaf, "exit leaf");
        }
        bytes32[] memory used = new bytes32[](1);
        used[0] = v.depositRoot();

        uint256 at;
        for (uint256 b; b < sizes.length; ++b) {
            BridgeVault.Exit[] memory batch = new BridgeVault.Exit[](sizes[b]);
            for (uint256 i; i < sizes[b]; ++i) {
                RV.ExitV memory e = ex[at + i];
                batch[i] = BridgeVault.Exit(e.token, e.denomIndex, e.commitment);
            }
            at += sizes[b];
            bytes32 prev = v.g2State();
            bytes memory journal = abi.encode(
                BridgeVault.UpdateJournal(
                    v.cfgId(),
                    prev,
                    keccak256(abi.encode(prev)),
                    b == 0 ? used : new bytes32[](0),
                    b == 0 ? claims : new BridgeVault.ClaimDelta[](0),
                    batch
                )
            );
            v.update(journal, mv.sealFor(G2, sha256(journal)));
            assertEq(v.exitRoot(), roots[b], "exit root after batch");
            assertEq(v.exitCount(), at);
            assertGt(v.exitRootTime(roots[b]), 0);
        }
    }

    function _balance(address token, address who) internal view returns (uint256) {
        return token == address(0) ? who.balance : TestToken(token).balanceOf(who);
    }

    function _wfee(address token, uint32 di) internal view returns (uint256) {
        (,,,,,,, uint256[] memory w,) = v.tokenConfig(token);
        return w[di];
    }

    function test_ExitRootsMatchFixture() public {
        _applyExits();
    }

    function test_ReleaseDigestEqualsGuestJournalDigest() public {
        _applyExits();
        RV.ReleaseV[] memory rs = RV.releases();
        assertEq(rs.length, 5);
        for (uint256 i; i < rs.length; ++i) {
            RV.ReleaseV memory r = rs[i];
            assertEq(sha256(r.journal), r.journalDigest, "fixture digest");
            // the guest's journal is byte for byte the vault's abi.encode
            assertEq(
                r.journal,
                abi.encode(v.cfgId(), r.root, r.nullifier, r.token, r.denom, r.recipient, r.relayer, r.relayFee),
                r.label
            );
            uint256 wfee = _wfee(r.token, r.denomIndex);
            uint256 toBefore = _balance(r.token, r.recipient);
            uint256 relBefore = _balance(r.token, r.relayer);
            bytes memory seal = mv.sealFor(G3, r.journalDigest);
            v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
            assertTrue(v.releaseNullifierSpent(r.nullifier));
            if (r.recipient == r.relayer) {
                assertEq(_balance(r.token, r.recipient) - toBefore, r.denom - wfee, r.label);
            } else {
                assertEq(_balance(r.token, r.recipient) - toBefore, r.denom - wfee - r.relayFee, r.label);
                if (r.relayer != address(0)) assertEq(_balance(r.token, r.relayer) - relBefore, r.relayFee, r.label);
            }
            // a copy of the same seal can't be released twice
            vm.expectRevert(BridgeVault.NullifierSpent.selector);
            v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
        }
    }

    /// A front-runner holding the seal can change nothing: recipient, relayer, fee, root, token
    /// and denomination are all in the digest.
    function test_CopiedSealCannotBeRedirected() public {
        _applyExits();
        RV.ReleaseV memory r = RV.releases()[1];
        bytes32[] memory roots = RV.batchRoots();
        bytes memory seal = mv.sealFor(G3, r.journalDigest);
        address thief = address(0xBAD);
        vm.startPrank(thief);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, thief, r.relayer, r.relayFee);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, thief, r.relayFee);
        // a fee off the menu is refused before the proof; another menu value fails the proof
        vm.expectRevert(BridgeVault.RelayFeeNotOnMenu.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee + 1);
        uint256 otherFee = RV.releases()[0].relayFee;
        assertTrue(otherFee != r.relayFee && v.relayFeeAllowed(r.token, r.denomIndex, otherFee));
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, otherFee);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, 0);
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, roots[3], r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
        // 0.01 ETH is 10% of the 0.1 ETH denomination, so it can never be on that menu
        vm.expectRevert(BridgeVault.RelayFeeNotOnMenu.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex - 1, r.recipient, r.relayer, r.relayFee);
        // with a fee allowed there the denomination change fails the proof
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex - 1, r.recipient, r.relayer, 0);
        // submitted unchanged by anyone, it pays exactly the recipient and the named relayer
        uint256 relBefore = _balance(r.token, r.relayer);
        v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
        vm.stopPrank();
        assertEq(_balance(r.token, r.relayer) - relBefore, r.relayFee);
        assertEq(_balance(r.token, thief), 0);
    }

    /// Guest journals from tampered witnesses (wrong k, ethDest, denom, cfgId, path, index, and a
    /// mid-batch root): their root was never recorded, so `release` refuses with that root, and the
    /// seal doesn't verify with a recorded root.
    function test_TamperedJournalsRejected() public {
        _applyExits();
        RV.ReleaseV[] memory bad = RV.rejected();
        bytes32[] memory roots = RV.batchRoots();
        assertEq(bad.length, 7);
        for (uint256 i; i < bad.length; ++i) {
            RV.ReleaseV memory r = bad[i];
            assertEq(sha256(r.journal), r.journalDigest);
            assertEq(v.exitRootTime(r.root), 0, r.label);
            bytes memory seal = mv.sealFor(G3, r.journalDigest);
            vm.expectRevert(BridgeVault.UnknownExitRoot.selector);
            v.release(seal, r.root, r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
            for (uint256 b; b < roots.length; ++b) {
                vm.expectRevert(MockVerifier.BadSeal.selector);
                v.release(seal, roots[b], r.nullifier, r.token, r.denomIndex, r.recipient, r.relayer, r.relayFee);
            }
        }
    }
}
