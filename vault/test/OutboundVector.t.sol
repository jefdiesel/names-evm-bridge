pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {BridgeVault} from "../src/BridgeVault.sol";
import {MockVerifier, TestToken} from "./mocks/Mocks.sol";
import {OutboundVector as OV} from "./fixtures/OutboundVector.sol";

/// Feeds the G2-lite journals of lez-bridge/outbound (generated by `outbound_host vector` from the
/// real LEZ blocks 2893..2904 of run public9, executed by the TrustedTip guest) to `update` on a
/// vault rebuilt exactly as run public9 had it: same chain id, address, program id and the same two
/// USDC deposits, so its cfgId and deposit root are the ones the LEZ blocks carry. The MockVerifier
/// accepts a seal only if it equals imageId | sha256(journal) for the digest the vault computes.
/// "mock-verified: proofs executed, not proved; LEZ finality trusted for the test."
contract OutboundVectorTest is Test {
    address constant VAULT = 0x1429859428C0aBc9C2C47C8Ee9FBaf82cFA0F20f;
    address constant USDC = 0xcbEAF3BDe82155F56486Fb5a1072cb8baAf547cc;
    bytes32 constant PROGRAM_ID = 0xe50aa81eca63f47552b2d56a12fb279941b51aa8a74ba814a59532b28e8b6242;
    bytes32 constant CFG_ID = 0x08897d4523bbf36bacbd0b7403e7e0b1c04efa0b3bdd1ad9450661ba6371c580;
    bytes32 constant ROOT = 0x05bbe0c005ad2872e35a5407727820315daadad54c8ff0a89eccc157775d7fe3;

    BridgeVault v;
    MockVerifier mv;

    function setUp() public {
        vm.chainId(31337);
        mv = new MockVerifier();
        bytes memory args = abi.encode(
            address(mv), OV.UPDATE_IMAGE_ID, keccak256("g3"), bytes32(0), bytes32(0), PROGRAM_ID, OV.GENESIS_STATE,
            uint64(0), address(this), address(this), address(this)
        );
        deployCodeTo("BridgeVault.sol:BridgeVault", args, VAULT);
        v = BridgeVault(VAULT);
        assertEq(v.cfgId(), CFG_ID, "cfgId of run public9");
        vm.etch(USDC, address(new TestToken("USDC", 6)).code);
        uint256[] memory d = new uint256[](2);
        d[0] = 100e6;
        d[1] = 1000e6;
        uint256[] memory f = new uint256[](2);
        v.registerToken(USDC, 6, d, f, f, 0);
        TestToken(USDC).mint(address(this), 1100e6);
        TestToken(USDC).approve(VAULT, type(uint256).max);
        // run/public9/deposits.txt
        v.deposit(USDC, 0, 0xc44725d218317976838f42c13d8a281490b76b98074c80d0dfd5e4b41bb5a2eb);
        v.deposit(USDC, 1, 0x7678c51bd5a2fa92e78db027890009818ac932c3433d1b2854cc9c8220f5045c);
        assertEq(v.depositRoot(), ROOT, "the root the LEZ stand-in attestor recorded in block 2899");
    }

    function _update(bytes memory j) internal {
        v.update(j, mv.sealFor(OV.UPDATE_IMAGE_ID, sha256(j)));
    }

    function test_GuestJournalsApplyAndMatchTheBridge() public {
        _update(OV.JOURNAL_1);
        assertEq(v.g2State(), OV.STATE_1);
        _update(OV.JOURNAL_2);
        assertEq(v.g2State(), OV.STATE_2);
        // = `lez-bridge show` for run public9: claims [1, 1], burns [1, 0], 1100e6 / 100e6
        (, uint64 c0, uint64 b0,) = v.counters(USDC, 0);
        (, uint64 c1, uint64 b1,) = v.counters(USDC, 1);
        assertEq(abi.encode(c0, c1, b0, b1), abi.encode(uint64(1), uint64(1), uint64(1), uint64(0)));
        assertEq(v.claimedValue(USDC), 1100e6);
        assertEq(v.burnedValue(USDC), 100e6);
        assertEq(v.exitCount(), 1);
        bytes32 leaf = v.exitLeaf(USDC, 100e6, OV.EXIT_COMMITMENT);
        bytes32 z = bytes32(0);
        bytes32 root = leaf;
        for (uint256 h; h < 32; ++h) {
            root = sha256(abi.encodePacked(root, z));
            z = sha256(abi.encodePacked(z, z));
        }
        assertEq(v.exitRoot(), root, "one exit leaf: E of block 2903");
        assertGt(v.exitRootTime(root), 0);
    }

    function test_StaleReorderedAndTamperedUpdatesRefused() public {
        bytes memory j1 = OV.JOURNAL_1;
        bytes memory j2 = OV.JOURNAL_2;
        bytes memory s1 = mv.sealFor(OV.UPDATE_IMAGE_ID, sha256(j1));
        bytes memory s2 = mv.sealFor(OV.UPDATE_IMAGE_ID, sha256(j2));
        bytes memory other = mv.sealFor(keccak256("g2"), sha256(j2));
        // the second batch first: its prevState is the first batch's newState
        vm.expectRevert(BridgeVault.StaleState.selector);
        v.update(j2, s2);
        v.update(j1, s1);
        // the first again
        vm.expectRevert(BridgeVault.StaleState.selector);
        v.update(j1, s1);
        // a journal byte changed under the original seal
        bytes memory t = OV.JOURNAL_2;
        t[t.length - 1] ^= 0x01;
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.update(t, s2);
        // another image's seal
        vm.expectRevert(MockVerifier.BadSeal.selector);
        v.update(j2, other);
        v.update(j2, s2);
        assertEq(v.g2State(), OV.STATE_2);
    }
}
